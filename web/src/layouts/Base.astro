---
// Kostra každé stránky: <head> (SEO, sdílení, ikony, písma, vložené CSS, strukturovaná data, skripty) a <body>.
// Tři druhy stránek se liší jen načítáním písma a skripty:
//   home   – úvodní stránka: písmo vložené přímo + předem načtená fotka (slot "head"), lead.js
//   sub    – podstránky služeb, články: písmo souborem fonts.css, lead.css, lead.js
//   simple – ochrana údajů, 404: písmo vložené přímo, bez formuláře
// CSS i skripty zůstávají vložené ve stránce (is:inline), stejně jako před převodem na Astro.
// Přechody mezi stránkami (@view-transition) jsou v motion.css, který se načítá všude.
import { SITE_URL, OG_IMAGE, asset, publicFile } from "../data/site";
import baseCss from "../styles/base.css?raw";
import { minCss } from "../lib/minify";

export interface Props {
  kind: "home" | "sub" | "simple";
  title: string;
  description: string;
  /** Adresa stránky od kořene ("/tvorba-webu/"); bez ní není canonical ani sdílení (404). */
  path?: string;
  robots?: string;
  og?: { type?: "website" | "article"; title?: string; description?: string; imageAlt?: string; published?: string };
  /** Hlavní CSS stránky (vkládá se do <style>). */
  css: string;
  /** Strukturovaná data (schema.org) – objekt, vypíše se jako JSON-LD. */
  jsonLd?: unknown;
}

const { kind, title, description, path, robots, og = {}, css, jsonLd } = Astro.props;
const url = path ? SITE_URL + path : undefined;
const ogTitle = og.title ?? title;
const ogDescription = og.description ?? description;
// Písmo vložené přímo do stránky = public/assets/fonts/fonts.css (podstránky ho načítají souborem) bez komentářů
// a zalomení – jeden zdroj pro obě varianty.
const fonts = publicFile("/assets/fonts/fonts.css").toString().replace(/\/\*[\s\S]*?\*\//g, "").replace(/\n/g, "");
const motionCss = asset("/assets/motion.css");
// Společný základ úvodní stránky a podstránek (styles/base.css) jde před jejich vlastní styly; ochrana údajů a 404
// mají jednodušší simple.css.
const pageCss = minCss(kind === "simple" ? css : baseCss + css);
---
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots}>}
{url && <link rel="canonical" href={url}>}
<meta name="theme-color" content="#ece3d4">
{/* motion.css se připojuje až za styly stránky (přebíjí je), tady se jen začne stahovat hned, ne až za vloženým CSS */}
<link rel="preload" href={motionCss} as="style">
{url && (
  <Fragment>
    <meta name="author" content="Jan Šporek">
    <meta property="og:type" content={og.type ?? "website"}>
    <meta property="og:locale" content="cs_CZ">
    <meta property="og:site_name" content="WebTitan">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={OG_IMAGE}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {og.imageAlt && <meta property="og:image:alt" content={og.imageAlt}>}
    {og.published && <meta property="article:published_time" content={og.published}>}
    {og.published && <meta property="article:author" content="Jan Šporek">}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content={OG_IMAGE}>
  </Fragment>
)}
<link rel="icon" href={asset("/favicon.ico")} sizes="32x32">
<link rel="icon" type="image/png" sizes="32x32" href={asset("/assets/favicon-32.png")}>
<link rel="apple-touch-icon" href={asset("/assets/apple-touch-icon.png")}>
<slot name="head" />
{kind === "sub" ? (
  <Fragment>
    <link rel="preload" href="/assets/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href={asset("/assets/fonts/fonts.css")}>
    <link rel="stylesheet" href={asset("/assets/lead.css")}>
  </Fragment>
) : (
  <Fragment>
    <link rel="preload" href="/assets/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/unbounded-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
    {kind === "home" && <script is:inline>document.documentElement.classList.add("js")</script>}
    <style is:inline set:html={fonts}></style>
  </Fragment>
)}
<style is:inline set:html={pageCss}></style>
{/* „<“ jako \u003c: text z FAQ nebo popisu (např. „</script>“) tak nemůže blok JSON-LD předčasně ukončit */}
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}></script>}
<script is:inline src={asset("/assets/analytics.js")} defer></script>
<script is:inline src={asset("/assets/consent.js")} defer></script>
{kind !== "simple" && <script is:inline src={asset("/assets/lead.js")} defer></script>}
<link rel="stylesheet" href={motionCss}>
<script is:inline src={asset("/assets/motion.js")} defer></script>
</head>
<body>
<slot />
</body>
</html>
