---
import ServiceSum from "../../components/ServiceSum.astro";
import HeroMicro from "../../components/HeroMicro.astro";
import Crumbs from "../../components/Crumbs.astro";
import CtaPair from "../../components/CtaPair.astro";
import { castka, castkaText, sluzba } from "../../data/sluzby";
import RefCase from "../../components/RefCase.astro";
import RefThumb from "../../components/RefThumb.astro";
import OthersCard from "../../components/OthersCard.astro";
import Sub from "../../layouts/Sub.astro";
import Faq from "../../components/Faq.astro";
import OtherServices from "../../components/OtherServices.astro";
import { graph, serviceLd, crumbsLd, faqLd } from "../../lib/ld";
import { otazky } from "../../data/otazky";

const path = "/tvorba-webu/";
const description = `Tvorba webových stránek na míru od ${castkaText("web")} pro firmy z Karlovarského a Plzeňského kraje. Design bez šablony, poptávky do e-mailu, obsah si upravíte sami.`;
/** Časté otázky (data/otazky.ts) – zobrazí se na stránce a zároveň jdou do strukturovaných dat. */
const faq = otazky(["budu-si-moci-web", "jak-dlouho-trva", "kolik-bude-stat", "komu-patri-aplikace-web", "postarate-hosting-provoz", "nemam-presne-zadani-vadi"]);
/** Drobečková navigace – na stránce i ve strukturovaných datech. */
const crumbs: [string, string][] = [["Domů", "/"], ["Tvorba webových stránek", path]];
const jsonLd = graph(
  serviceLd({ path, name: "Tvorba webových stránek", serviceType: "Tvorba webových stránek", description, minPrice: sluzba("web").od }),
  crumbsLd(crumbs),
  faqLd(faq),
);
---
<Sub
  title="Tvorba webových stránek – Karlovy Vary, Sokolov, Plzeň | WebTitan"
  description={description}
  path={path}
  og={{ title: `Tvorba webových stránek na míru od ${castkaText("web")} – WebTitan` }}
  jsonLd={jsonLd}
  offer="web"
  cta="sp"
  lead={{"heading": "Pojďme probrat váš nový web", "topic": "Web", "placeholder": "Např. máme starý web, ze kterého nechodí žádné poptávky, a chceme nový."}}
>
  <section class="sp-hero">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="hero-grid">
        <div class="card intro">
          <div><span class="kicker">Firemní web</span></div>
          <h1>Tvorba webových stránek na míru</h1>
          <p class="lead">Firemní web, který zákazníkům rychle řekne, co děláte, a&nbsp;přivede vám poptávky. Postavím vám rychlý a&nbsp;přehledný web přesně podle toho, jak vaše firma funguje – bez agentury, bez zbytečných schůzek, s&nbsp;jedním člověkem, který to celé udělá.</p>
          <ul class="checks"><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Design na míru, žádná šablona</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Poptávkový formulář přímo do e-mailu</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Obsah si upravíte sami</li></ul>
          <CtaPair track="sp_hero" />
          <HeroMicro track="sp_hero" />
        </div>
        <ServiceSum price={`od ${castka("web")}`} priceNote="pevná cena předem" termin="obvykle 2–4 týdny" />
      </div>
    </div>
  </section>

  <section class="sec" id="pro-koho">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Poznáváte se?</span><h2>Kdy je čas na nový web</h2></div><p>Pokud vám aspoň jeden bod zní povědomě, má smysl se pobavit.</p></div>
      <div class="pains"><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span><h3>Web nepřivádí poptávky</h3><p>Existuje, ale telefon nezvoní a&nbsp;formulář mlčí. A&nbsp;nikdo vám neřekne proč.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4M3 3l18 18"/></svg></span><h3>Za starý web se stydíte</h3><p>Na mobilu se rozpadá, načítá se věčnost a&nbsp;zákazníkům ho radši neposíláte.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg></span><h3>Agentura chce statisíce a&nbsp;půl roku</h3><p>Na velký projekt nemáte rozpočet ani čas. Potřebujete začít menším krokem.</p></article></div>
    </div>
  </section>

  <section class="sec" id="co-dostanete">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Co dostanete</span><h2>Co dostanete s&nbsp;novým webem</h2></div><p>Web je rychlý, srozumitelný a&nbsp;skvěle vypadá i&nbsp;na mobilu – a&nbsp;hlavně je postavený tak, aby z&nbsp;návštěvníků byli zákazníci.</p></div>
      <div class="get"><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Design na míru, žádná šablona</h3><p>Web navrhnu podle vaší firmy, ne podle hotové šablony.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Poptávkový formulář přímo do e-mailu</h3><p>Zákazník napíše pár vět a&nbsp;poptávka vám rovnou přijde do e-mailu.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Obsah si upravíte sami</h3><p>Texty, fotky i&nbsp;novinky si upravíte v&nbsp;jednoduché administraci. Větší změny rád udělám za vás.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Rychlý a&nbsp;dobře čitelný i&nbsp;na mobilu</h3><p>Web zákazníkům rychle řekne, co děláte, ať si ho prohlížejí kdekoli.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Doména, kód i&nbsp;data patří vám</h3><p>Nejste na mně závislí – web je celý váš.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Hosting a&nbsp;správa</h3><p>O&nbsp;servery, aktualizace i&nbsp;zálohy se můžu postarat já, od <Fragment set:html={castka("srv")} /> měsíčně.</p></div></div></div>
    </div>
  </section>

  <section class="sec" id="postup">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Jak pracuji</span><h2>Jak probíhá tvorba webu</h2></div><p>Víte, co se kdy děje a&nbsp;kolik to bude stát – ještě než se do čehokoli pustíme.</p></div>
      <ol class="steps"><li class="card step"><div class="step-top"><span class="num">1</span><span class="time">do 24 h · zdarma</span></div><h3>15min hovor</h3><p>Projdeme, co vás dnes zdržuje. Řeknu vám, jestli a&nbsp;jak to jde – po telefonu nebo videohovorem.</p></li><li class="card step"><div class="step-top"><span class="num">2</span><span class="time">cca 1 týden</span></div><h3>Návrh a&nbsp;pevná cena</h3><p>Sepíšu, co bude web obsahovat, ukážu náhled a&nbsp;pošlu pevnou cenu. Teprve pak se rozhodnete.</p></li><li class="card step"><div class="step-top"><span class="num">3</span><span class="time">obvykle 2–4 týdny</span></div><h3>Vývoj s&nbsp;průběžnými ukázkami</h3><p>Průběžně vidíte pokrok a&nbsp;můžete říct, co upravit. Žádná černá skříňka.</p></li><li class="card step"><div class="step-top"><span class="num">4</span><span class="time">průběžně</span></div><h3>Spuštění a&nbsp;péče</h3><p>Spustím web, zaškolím vás a&nbsp;postarám se o&nbsp;servery, zálohy i&nbsp;další rozvoj.</p></li></ol>
    </div>
  </section>

  <section class="sec" id="cena">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Cena</span><h2>Kolik stojí tvorba webových stránek</h2></div></div>
      <div class="card price-card gb">
        <div class="price-big"><small>Cena</small><b class="gt">od <Fragment set:html={castka("web")} /></b><span>pevná cena za konkrétní rozsah</span></div>
        <div><ul><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Pevnou cenu dostanete po úvodním hovoru – co si odsouhlasíme, to platí.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Firemní web bývá hotový obvykle za 2–4 týdny.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Provoz a&nbsp;správa se platí zvlášť, od <Fragment set:html={castka("srv")} /> měsíčně.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Nejsem plátce DPH, takže uvedené ceny jsou konečné.</li></ul><p class="price-note">Výsledná cena záleží na rozsahu – co má řešení umět a&nbsp;na co ho napojíme. Přesnou cenu vám řeknu po úvodním hovoru. Podrobněji v&nbsp;článku <a href="/clanky/kolik-stoji-web-a-e-shop/">Kolik stojí firemní web a&nbsp;e-shop</a>, co by měl umět web místní firmy, najdete v&nbsp;článku <a href="/clanky/web-pro-remeslniky-a-mistni-firmy/">Web pro řemeslníky a&nbsp;místní firmy</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="sec" id="reference">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Reference</span><h2>Weby, které jsem postavil</h2></div></div>
      <div class="cases"><RefCase id="fitness-ural" /><RefCase id="gprooms" /><RefCase id="dev-duck" /></div>
      <div class="thumbs"><RefThumb id="penzion-loket" /><RefThumb id="kotelna55" /><RefThumb id="rybar-transport" /></div>
      <OthersCard names={["2MSKV", "Astos", "Firemní balíček", "František Slovák", "Geowestmaster", "Hostel Loket", "Kanya Kage", "Markop Okna", "Plenkový servis", "Recysmach", "Sokolov Ubytování"]} />
      <p class="refs-more"><a href="/#reference" class="link-cta">Všechny reference <span class="arr" aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <Faq heading="Časté otázky k&nbsp;tvorbě webu" items={faq} />
  <OtherServices ids={["app", "mob", "shop", "srv"]} />
</Sub>
