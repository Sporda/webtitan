---
// Úvodní stránka. Obsah sekcí je tady; menu, patička, ikony a hlavička z komponent, otázky z data/otazky.ts,
// údaje o firmě pro vyhledávače z data/schema.ts, hlavní skript (rezervace, formuláře, kalkulačka…) ze src/scripts/home.js.
import RefCase from "../components/RefCase.astro";
import RefThumb from "../components/RefThumb.astro";
import { ZADAVATELE } from "../data/reference";
import Base from "../layouts/Base.astro";
import Sprite from "../components/Sprite.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import homeCss from "../styles/home.css?raw";
import homeJs from "../scripts/home.js?raw";
import { otazky } from "../data/otazky";
import { PERSON, BUSINESS, WEBSITE } from "../data/schema";
import { graph, faqLd } from "../lib/ld";

const faq = otazky(["jak-probiha-15min-hovor", "kde-pusobite-muzeme-potkat", "kolik-bude-stat", "delate-mobilni-aplikace", "nemam-presne-zadani-vadi", "jak-dlouho-trva", "komu-patri-aplikace-web", "umite-prevzit-data-excelu", "budu-si-moci-web", "napojite-ucetnictvi-platby-nebo", "postarate-hosting-provoz", "co-stane-po-odeslani"]);
const jsonLd = graph(PERSON, BUSINESS, WEBSITE, { "@id": "https://webtitan.cz/#faq", ...faqLd(faq) });
---
<Base
  kind="home"
  title="Vývoj aplikací, weby a e-shopy – Karlovy Vary, Plzeň | WebTitan"
  description="Aplikace na míru od 24 950 Kč, weby od 9 970 Kč a e-shopy od 19 870 Kč pro firmy z Karlovarského a Plzeňského kraje. Pevná cena předem, přímo s programátorem."
  path="/"
  og={{ title: "Jan Šporek – vývoj aplikací na míru, tvorba webů a e-shopů", description: "Vývoj aplikací na míru, mobilní aplikace, tvorba webů a e-shopů pro firmy ze západních Čech. Pevná cena předem, nezávazný 15min hovor zdarma.", imageAlt: "Jan Šporek – WebTitan: aplikace, weby a e-shopy na míru" }}
  css={homeCss}
  jsonLd={jsonLd}
>
<link slot="head" rel="preload" as="image" href="/assets/jan-cut.webp" imagesrcset="/assets/jan-cut-400.webp 400w, /assets/jan-cut.webp 800w" imagesizes="(max-width: 1040px) 90vw, 400px" type="image/webp" fetchpriority="high">
<Sprite variant="home" />

<Nav variant="home" />

<main>
  <!-- ================= HERO ================= -->
  <section class="hero" id="hero">
    <div class="bg-blob b1" aria-hidden="true"></div>
    <div class="bg-blob b2" aria-hidden="true"></div>
    <div class="wrap">
      <div class="bento">
        <div class="card intro">
          <div>
            <div class="seg" role="tablist" aria-label="Co potřebujete">
              <button type="button" role="tab" id="seg-app" data-seg-btn="app" aria-selected="true" aria-controls="hero-copy" tabindex="0"><svg><use href="#i-app"/></svg><span class="l-long">Potřebuji aplikaci / systém</span><span class="l-short">Aplikace / systém</span></button>
              <button type="button" role="tab" id="seg-web" data-seg-btn="web" aria-selected="false" aria-controls="hero-copy" tabindex="-1"><svg><use href="#i-web"/></svg><span class="l-long">Potřebuji web / e-shop</span><span class="l-short">Web / e-shop</span></button>
            </div>
            <div id="hero-copy" role="tabpanel" aria-labelledby="seg-app" aria-live="polite">
              <h1>
                <span data-only="app">Z&nbsp;Excelu, e-mailů a&nbsp;papírků do <span class="gt">jedné přehledné aplikace</span>.</span>
                <span data-only="web" hidden>Web nebo <span class="nw">e-shop</span>, který vám <span class="gt">přivede zákazníky</span>.</span>
              </h1>
              <p class="lead" data-only="app">Zakázky, termíny, zákazníci i&nbsp;rezervace na jednom místě. Navrhnu a&nbsp;postavím systém přesně podle toho, jak vaše firma pracuje – a&nbsp;postarám se, aby spolehlivě běžel.</p>
              <p class="lead" data-only="web" hidden>Postavím vám rychlý a&nbsp;přehledný web nebo e-shop přesně podle toho, jak vaše firma funguje. Bez agentury, bez zbytečných schůzek – s&nbsp;jedním člověkem, který to celé udělá a&nbsp;zvedne telefon.</p>
              <ul class="checks" data-only="app">
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Pevná cena předem – co si odsouhlasíme, to platí</li>
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Začnete v&nbsp;malém, rozšíříte, až to bude dávat smysl</li>
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Aplikace, kód i&nbsp;data patří vám</li>
              </ul>
              <ul class="checks" data-only="web" hidden>
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Pevná cena předem – co si odsouhlasíme, to platí</li>
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Konzultace a&nbsp;návrh řešení zdarma a&nbsp;nezávazně</li>
                <li><span class="tick"><svg><use href="#i-check"/></svg></span>Jednáte přímo se mnou – od prvního hovoru po spuštění</li>
              </ul>
              <p class="anchor" data-only="app"><span>Aplikace na míru</span><b>od 24&nbsp;950&nbsp;Kč</b><span>jednorázově, bez licencí za uživatele</span></p>
              <p class="anchor" data-only="web" hidden><span class="pair"><span>Web</span><b>od 9&nbsp;970&nbsp;Kč</b></span><i>·</i><span class="pair"><span>E-shop</span><b>od 19&nbsp;870&nbsp;Kč</b></span></p>
            </div>
          </div>
          <div>
            <div class="dual">
              <a href="#kontakt" class="btn btn-grad" data-open="call" data-cta="hero_call"><svg><use href="#i-phone"/></svg>Domluvit 15min hovor</a>
              <a href="#kontakt" class="btn btn-line" data-open="form" data-cta="hero_form">Poslat poptávku <span class="arr">→</span></a>
            </div>
            <p class="micro">
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Ozvu se do 24 hodin (v&nbsp;pracovní dny)</span>
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Karlovarský a&nbsp;Plzeňský kraj – i&nbsp;osobně</span>
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Volejte rovnou: <a href="tel:+420723793510" data-cta="hero_tel">723&nbsp;793&nbsp;510</a></span>
              <span class="cap-badge" data-capacity hidden></span>
            </p>
          </div>
        </div>

        <div class="card photo">
          <img src="/assets/jan-cut.webp" srcset="/assets/jan-cut-400.webp 400w, /assets/jan-cut.webp 800w" sizes="(max-width: 1040px) 90vw, 400px" alt="Jan Šporek" width="800" height="720" fetchpriority="high">
          <p class="pnote">„Napište mi pár vět o&nbsp;tom, co potřebujete. Ozvu se vám osobně – žádné call centrum ani chatbot.“<b>— Jan</b></p>
          <div class="who">
            <div><b>Jan Šporek</b><span>20+ let praxe · 23 realizovaných projektů</span></div>
            <a class="icon-btn" href="https://www.linkedin.com/in/jan-%C5%A1porek-07a39168/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
          </div>
        </div>

        <div class="card callc gb" aria-labelledby="callc-t">
          <div class="callc-head">
            <span class="callc-ic"><svg><use href="#i-phone"/></svg></span>
            <div><b id="callc-t">Domluvte si 15min hovor</b><span>Zdarma a&nbsp;nezávazně. Vyberte den, čas doladíme.</span></div>
          </div>
          <div class="hdays" id="hero-days" role="group" aria-label="Nejbližší volné dny pro hovor">
            <!-- vyplní JS: nejbližší 3 pracovní dny -->
            <a href="#kontakt" class="hday more" data-open="call" data-cta="hero_days_more"><b>Vybrat termín</b><small>další dny →</small></a>
          </div>
          <ol class="callc-steps">
            <li><span>1</span>Vyberete den a&nbsp;čas</li>
            <li><span>2</span>Termín potvrdím e-mailem</li>
            <li><span>3</span>15 minut – řeknu, jestli a&nbsp;jak to jde</li>
          </ol>
          <p class="callc-foot"><span><svg><use href="#i-check"/></svg>Zdarma, nic nepodepisujete</span><span>Raději píšete? <a href="#kontakt" data-open="form" data-cta="hero_card_form">Poslat poptávku</a></span></p>
        </div>

        <div class="card stat lift">
          <div class="stat-top"><b class="gt">20+</b><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span></div>
          <span>let praxe – weby stavím od roku 2006</span>
        </div>
        <div class="card stat lift">
          <div class="stat-top"><b class="gt">23</b><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8"/></svg></span></div>
          <span>realizovaných aplikací, webů a&nbsp;e-shopů</span>
        </div>
        <div class="card stat lift">
          <div class="stat-top"><b class="gt">24&nbsp;h</b><span class="ic"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span></div>
          <span>do odpovědi na poptávku (v&nbsp;pracovní dny)</span>
        </div>
        <div class="card stat lift">
          <div class="stat-top"><b class="gt">1</b><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span></div>
          <span>člověk od návrhu přes vývoj po provoz</span>
        </div>

        <div class="card clients">
          <span class="lbl">Realizace pro</span>
          <div class="marquee" aria-label="Vybraní klienti">
            <div class="marquee-track">
              <span>Fitness Ural</span><span>GP Rooms</span><span>Hostel Loket</span><span>Penzion Loket</span><span>Skripta Prokop</span><span>Markop Okna</span><span>Rybar Transport</span><span>Geowestmaster</span><span>GP Tents</span><span>Sunpoint</span><span>2MSKV</span><span>Recysmach</span><span>Sokolov Ubytování</span>
              <span aria-hidden="true">Fitness Ural</span><span aria-hidden="true">GP Rooms</span><span aria-hidden="true">Hostel Loket</span><span aria-hidden="true">Penzion Loket</span><span aria-hidden="true">Skripta Prokop</span><span aria-hidden="true">Markop Okna</span><span aria-hidden="true">Rybar Transport</span><span aria-hidden="true">Geowestmaster</span><span aria-hidden="true">GP Tents</span><span aria-hidden="true">Sunpoint</span><span aria-hidden="true">2MSKV</span><span aria-hidden="true">Recysmach</span><span aria-hidden="true">Sokolov Ubytování</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PAINS ================= -->
  <section class="sec" id="problemy">
    <div class="wrap">
      <div class="head rv">
        <div><span class="kicker gt">Poznáváte se?</span><h2>Tohle slýchám od podnikatelů nejčastěji</h2></div>
        <p>Pokud vám aspoň jeden bod zní povědomě, má smysl se pobavit. Většinu z&nbsp;toho jde vyřešit rychleji a&nbsp;levněji, než čekáte.</p>
      </div>
      <div class="pains">
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg></span>
          <h3>Excel, kterému rozumí jen jeden člověk</h3>
          <p>Když je na dovolené, nikdo neví, co platí. A&nbsp;verzí té tabulky je pět.</p>
        </article>
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
          <h3>Termíny v&nbsp;diáři a&nbsp;v&nbsp;hlavě</h3>
          <p>Stačí jeden zapomenutý termín a&nbsp;zákazník příště zavolá jinam.</p>
        </article>
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></span>
          <h3>Pořád dokola stejné přepisování</h3>
          <p>Objednávky, rezervace a&nbsp;výkazy přepisujete ručně z&nbsp;jednoho místa do druhého.</p>
        </article>
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span>
          <h3>Web nepřivádí poptávky</h3>
          <p>Existuje, ale telefon nezvoní a&nbsp;formulář mlčí. A&nbsp;nikdo vám neřekne proč.</p>
        </article>
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4M3 3l18 18"/></svg></span>
          <h3>Za starý web se stydíte</h3>
          <p>Na mobilu se rozpadá, načítá se věčnost a&nbsp;zákazníkům ho radši neposíláte.</p>
        </article>
        <article class="card pain lift rv">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg></span>
          <h3>Agentura chce statisíce a&nbsp;půl roku</h3>
          <p>Na velký projekt nemáte rozpočet ani čas. Potřebujete začít menším krokem.</p>
        </article>
      </div>
      <div class="card bridge rv">
        <div>
          <h3>Dobrá zpráva: nic z&nbsp;toho nemusíte dál snášet.</h3>
          <p>Řeknete mi, co vás trápí, a&nbsp;já navrhnu nejjednodušší řešení, které dává smysl. Někdy je to nový web, jindy malá aplikace místo Excelu – a&nbsp;někdy stačí opravit to, co už máte.</p>
        </div>
        <div class="dual">
          <a href="#kontakt" class="btn btn-grad" data-open="call" data-cta="pains_call"><svg><use href="#i-phone"/></svg>Domluvit 15min hovor</a>
          <a href="#kontakt" class="btn btn-line" data-open="form" data-cta="pains_form">Poslat poptávku</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BEFORE / AFTER ================= -->
  <section class="sec" id="reseni">
    <div class="wrap">
      <div class="head center rv">
        <span class="kicker gt">Řešení</span>
        <h2>Jedno místo, kde všechno sedí</h2>
        <p>Aplikace na míru nekopíruje cizí postupy. Převezme ten váš a&nbsp;odstraní z&nbsp;něj ruční práci.</p>
      </div>
      <div class="ba">
        <div class="card ba-col before rv">
          <span class="ba-label"><svg style="width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round"><use href="#i-x"/></svg>Dnes</span>
          <h3>Excel, diář a&nbsp;papírky</h3>
          <ul>
            <li><span class="mk"><svg><use href="#i-x"/></svg></span>Data v&nbsp;několika tabulkách a&nbsp;e-mailech</li>
            <li><span class="mk"><svg><use href="#i-x"/></svg></span>Aktuální stav zná jen ten, kdo zrovna zvedl telefon</li>
            <li><span class="mk"><svg><use href="#i-x"/></svg></span>Stejné údaje přepisujete několikrát – i&nbsp;s&nbsp;chybami</li>
            <li><span class="mk"><svg><use href="#i-x"/></svg></span>Přehled pro vedení znamená obvolat lidi</li>
            <li><span class="mk"><svg><use href="#i-x"/></svg></span>Zaučit nového kolegu trvá dlouho</li>
          </ul>
        </div>
        <div class="ba-arrow" aria-hidden="true"><span><svg><use href="#i-arrow"/></svg></span></div>
        <div class="card ba-col after gb rv">
          <span class="ba-label"><svg style="width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round"><use href="#i-check"/></svg>S&nbsp;aplikací na míru</span>
          <h3>Jedna přehledná aplikace</h3>
          <ul>
            <li><span class="mk"><svg><use href="#i-check"/></svg></span>Zakázky, zákazníci a&nbsp;termíny na jednom místě</li>
            <li><span class="mk"><svg><use href="#i-check"/></svg></span>Každý vidí aktuální stav – v&nbsp;kanceláři i&nbsp;z&nbsp;mobilu</li>
            <li><span class="mk"><svg><use href="#i-check"/></svg></span>Údaj zadáte jednou, aplikace ho použije všude</li>
            <li><span class="mk"><svg><use href="#i-check"/></svg></span>Přehledy a&nbsp;exporty na jedno kliknutí</li>
            <li><span class="mk"><svg><use href="#i-check"/></svg></span>Aplikace vede krok za krokem – i&nbsp;nováčka</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ROI CALCULATOR ================= -->
  <section class="sec" id="kalkulacka">
    <div class="wrap">
      <div class="card roi rv">
        <div class="roi-in">
          <div>
            <span class="kicker gt">Spočítejte si to</span>
            <h2>Kolik vás stojí ruční práce?</h2>
          </div>
          <p>Posuňte jezdce podle toho, jak to máte ve firmě. Výpočet běží jen ve vašem prohlížeči – nikam se neodesílá.</p>
          <div class="rng">
            <div class="rng-top"><label for="roi-people">Kolik lidí to dělá</label><output id="roi-people-o" for="roi-people">3 lidé</output></div>
            <input type="range" id="roi-people" min="1" max="30" step="1" value="3">
          </div>
          <div class="rng">
            <div class="rng-top"><label for="roi-hours">Hodin týdně na člověka <em>přepisování, hledání, evidence</em></label><output id="roi-hours-o" for="roi-hours">4 h</output></div>
            <input type="range" id="roi-hours" min="0.5" max="20" step="0.5" value="4">
          </div>
          <div class="rng">
            <div class="rng-top"><label for="roi-share">Kolik z&nbsp;toho by aplikace ušetřila <em>odhad</em></label><output id="roi-share-o" for="roi-share">50 %</output></div>
            <input type="range" id="roi-share" min="10" max="90" step="5" value="50">
          </div>
          <div class="rng">
            <div class="rng-top"><label for="roi-rate">Náklady na hodinu práce <em>upravte podle sebe</em></label></div>
            <div class="rate"><input type="number" id="roi-rate" min="100" max="5000" step="10" value="350" inputmode="numeric"><span>Kč / hod.</span></div>
          </div>
        </div>
        <div class="roi-out" aria-live="polite">
          <div class="roi-big">
            <small>Ruční práce vás stojí zhruba</small>
            <b id="roi-month" class="gt">18&nbsp;186&nbsp;Kč</b>
            <span class="roi-note">měsíčně · <span id="roi-hours-month">52</span>&nbsp;hodin práce</span>
          </div>
          <div class="roi-row">
            <div><small>Za rok</small><b id="roi-year">218&nbsp;232&nbsp;Kč</b></div>
            <div><small>Aplikace by ušetřila</small><b id="roi-save">9&nbsp;093&nbsp;Kč/měs.</b></div>
          </div>
          <p class="roi-pay" id="roi-pay">Aplikace od 24&nbsp;950&nbsp;Kč by se při této úspoře vrátila zhruba za <b>2,7&nbsp;měsíce</b>.</p>
