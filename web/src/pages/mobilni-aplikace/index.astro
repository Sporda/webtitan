---
import Sub from "../../layouts/Sub.astro";
import Faq from "../../components/Faq.astro";
import OtherServices from "../../components/OtherServices.astro";
import { graph, serviceLd, crumbsLd, faqLd } from "../../lib/ld";
import { otazky } from "../../data/otazky";

const path = "/mobilni-aplikace/";
const description = "Vývoj mobilních aplikací pro iOS i Android pro firmy z Karlovarského a Plzeňského kraje. Napojení na váš systém, web nebo e-shop. Cenu řeknu po 15min hovoru.";
/** Časté otázky (data/otazky.ts) – zobrazí se na stránce a zároveň jdou do strukturovaných dat. */
const faq = otazky(["delate-mobilni-aplikace", "kolik-bude-stat", "komu-patri-aplikace-web", "napojite-ucetnictvi-platby-nebo", "nemam-presne-zadani-vadi", "jak-probiha-15min-hovor"]);
const jsonLd = graph(
  serviceLd({ path, name: "Mobilní aplikace", serviceType: "Vývoj mobilních aplikací", description }),
  crumbsLd([["Domů", "/"], ["Mobilní aplikace", path]]),
  faqLd(faq),
);
---
<Sub
  title="Mobilní aplikace pro iOS a Android – Karlovy Vary, Plzeň | WebTitan"
  description={description}
  path={path}
  og={{ title: "Vývoj mobilních aplikací pro iOS a Android – WebTitan" }}
  jsonLd={jsonLd}
  offer="app"
  cta="sp"
  lead={{"heading": "Pojďme probrat vaši mobilní aplikaci", "topic": "Mobilní aplikace", "placeholder": "Např. chceme, aby si zákazníci objednávali z mobilu a my to hned viděli v systému."}}
>
  <section class="sp-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Drobečková navigace"><ol><li><a href="/">Domů</a></li><li aria-current="page">Mobilní aplikace</li></ol></nav>
      <div class="hero-grid">
        <div class="card intro">
          <div><span class="kicker">Mobilní aplikace na míru</span></div>
          <h1>Vývoj mobilních aplikací pro iOS a&nbsp;Android</h1>
          <p class="lead">Mobilní aplikace na míru pro vaše zákazníky nebo zaměstnance v&nbsp;terénu. Postavím ji pro iOS i&nbsp;Android z&nbsp;jednoho kódu a&nbsp;napojím na váš systém, web nebo e-shop – ať všichni pracují se stejnými daty.</p>
          <ul class="checks"><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>iOS i&nbsp;Android z&nbsp;jednoho kódu</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Napojení na váš systém a&nbsp;data</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Pomoc s&nbsp;vydáním v&nbsp;App Store a&nbsp;Google Play</li></ul>
          <div class="dual"><a href="#poptat" class="btn btn-grad" data-mode="call" data-cta="sp_hero_call"><svg aria-hidden="true"><use href="#i-phone"/></svg>Domluvit 15min hovor</a><a href="#poptat" class="btn btn-line" data-mode="form" data-cta="sp_hero_form">Poslat poptávku</a></div>
          <p class="micro"><span class="mi"><svg aria-hidden="true"><use href="#i-clock"/></svg>Ozvu se do 24 hodin (v&nbsp;pracovní dny)</span><span class="mi"><svg aria-hidden="true"><use href="#i-pin"/></svg>Karlovarský a&nbsp;Plzeňský kraj – i&nbsp;osobně</span><span class="mi"><svg aria-hidden="true"><use href="#i-phone"/></svg>Volejte rovnou: <a href="tel:+420723793510" data-cta="sp_hero_tel">723&nbsp;793&nbsp;510</a></span></p>
        </div>
        <aside class="card sum" aria-label="Shrnutí">
          <div class="sum-price"><small>Cena</small><b class="gt">podle rozsahu</b><span>nacením po úvodním hovoru</span></div>
          <dl class="facts">
            <div class="fact"><dt>Termín</dt><dd>podle rozsahu – přesný termín dostanete spolu s&nbsp;cenou</dd></div>
            <div class="fact"><dt>Komu patří kód a&nbsp;data</dt><dd>Vám – kód, data i&nbsp;doména</dd></div>
            <div class="fact"><dt>S&nbsp;kým jednáte</dt><dd>Přímo s&nbsp;tím, kdo to staví</dd></div>
            <div class="fact"><dt>DPH</dt><dd>Nejsem plátce DPH – ceny jsou konečné</dd></div>
          </dl>
          <div class="me-row"><span class="avatar" role="img" aria-label="Jan Šporek"></span><div><b>Jan Šporek</b><span>Weby a&nbsp;aplikace stavím od roku 2006, sídlím u&nbsp;Sokolova. Kdo s&nbsp;vámi mluví, ten to i&nbsp;staví – v&nbsp;Karlovarském a&nbsp;Plzeňském kraji klidně i&nbsp;osobně.</span></div></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="sec" id="pro-koho">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Pro koho to je</span><h2>Pro koho mobilní aplikaci postavím</h2></div><p>Mobilní aplikace dává smysl tam, kde lidé potřebují pracovat se stejnými daty i&nbsp;mimo kancelář – nebo tam, kde chcete být zákazníkům blíž.</p></div>
      <div class="pains ok"><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><h3>Pro vaše zákazníky</h3><p>Objednávky, rezervace nebo věrnostní program přímo v&nbsp;telefonu zákazníka.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="6.5" y="2" width="11" height="20" rx="2.5"/><path d="M11 18h2"/></svg></span><h3>Pro zaměstnance v&nbsp;terénu</h3><p>Lidé venku vidí aktuální stav a&nbsp;zapisují do stejného systému jako kancelář.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></span><h3>Napojení na to, co už máte</h3><p>Aplikaci napojím na váš systém, web nebo e-shop, takže se údaje nepřepisují ručně.</p></article></div>
    </div>
  </section>

  <section class="sec" id="co-dostanete">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Co dostanete</span><h2>Co s&nbsp;mobilní aplikací dostanete</h2></div><p>Od návrhu přes vývoj až po vydání v&nbsp;obchodech s&nbsp;aplikacemi – a&nbsp;jednáte celou dobu přímo se mnou.</p></div>
      <div class="get"><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>iOS i&nbsp;Android z&nbsp;jednoho kódu</h3><p>Jedna aplikace pro oba systémy – bez dvojího vývoje.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Napojení na váš systém a&nbsp;data</h3><p>Aplikace pracuje se stejnými daty jako váš systém, web nebo e-shop.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Pomoc s&nbsp;vydáním v&nbsp;App Store a&nbsp;Google Play</h3><p>Pomůžu vám aplikaci dostat k&nbsp;uživatelům v&nbsp;obou obchodech.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Napojení na další služby</h3><p>Pokud druhá strana nabízí rozhraní (API), napojím aplikaci na platební brány, účetní systémy, e-mail a&nbsp;další.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Kód a&nbsp;data patří vám</h3><p>Kód, data i&nbsp;doména jsou vaše a&nbsp;data si můžete kdykoli vyexportovat. Nejste na mně závislí.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Jednáte přímo se mnou</h3><p>Kdo s&nbsp;vámi mluví, ten to i&nbsp;staví – bez obchodníků a&nbsp;projektových manažerů.</p></div></div></div>
      <p class="tech">React Native · iOS · Android</p>
    </div>
  </section>

  <section class="sec" id="postup">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Jak pracuji</span><h2>Jak probíhá vývoj mobilní aplikace</h2></div><p>Víte, co se kdy děje a&nbsp;kolik to bude stát – ještě než se do čehokoli pustíme.</p></div>
      <ol class="steps"><li class="card step"><div class="step-top"><span class="num">1</span><span class="time">do 24 h · zdarma</span></div><h3>15min hovor</h3><p>Projdeme, co vás dnes zdržuje. Řeknu vám, jestli a&nbsp;jak to jde – po telefonu nebo videohovorem.</p></li><li class="card step"><div class="step-top"><span class="num">2</span><span class="time">cca 1 týden</span></div><h3>Návrh a&nbsp;pevná cena</h3><p>Sepíšu, co bude řešení umět, ukážu náhled obrazovek a&nbsp;pošlu pevnou cenu. Teprve pak se rozhodnete.</p></li><li class="card step"><div class="step-top"><span class="num">3</span><span class="time">podle rozsahu</span></div><h3>Vývoj s&nbsp;průběžnými ukázkami</h3><p>Průběžně vidíte pokrok a&nbsp;můžete říct, co upravit. Žádná černá skříňka.</p></li><li class="card step"><div class="step-top"><span class="num">4</span><span class="time">průběžně</span></div><h3>Vydání a&nbsp;péče</h3><p>Pomůžu s&nbsp;vydáním v&nbsp;App Store a&nbsp;Google Play a&nbsp;postarám se o&nbsp;servery, zálohy i&nbsp;další rozvoj.</p></li></ol>
    </div>
  </section>

  <section class="sec" id="cena">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Cena</span><h2>Kolik stojí mobilní aplikace</h2></div></div>
      <div class="card price-card gb">
        <div class="price-big"><small>Cena</small><b class="gt">podle rozsahu</b><span>nacením po úvodním hovoru</span></div>
        <div><ul><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Cenu řeknu podle rozsahu po úvodním hovoru.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Pevnou cenu dostanete předem – co si odsouhlasíme, to platí.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Začít můžete i&nbsp;menší první verzí.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Nejsem plátce DPH, takže uvedené ceny jsou konečné.</li></ul><p class="price-note">Výsledná cena záleží na rozsahu – co má řešení umět a&nbsp;na co ho napojíme. Přesnou cenu vám řeknu po úvodním hovoru. Podrobněji v&nbsp;článku <a href="/clanky/kolik-stoji-aplikace-na-miru/">Kolik stojí aplikace na míru a&nbsp;co cenu ovlivňuje</a>.</p></div>
      </div>
    </div>
  </section>
  <Faq heading="Časté otázky k&nbsp;mobilním aplikacím" items={faq} />
  <OtherServices ids={["app", "web", "shop", "srv"]} />
</Sub>
