---
import Sub from "../../layouts/Sub.astro";
import Faq from "../../components/Faq.astro";
import OtherServices from "../../components/OtherServices.astro";
import { graph, serviceLd, crumbsLd, faqLd } from "../../lib/ld";
import { otazky } from "../../data/otazky";

const path = "/sprava-serveru/";
const description = "Správa serverů a webů od 990 Kč měsíčně pro firmy ze západních Čech: hosting, aktualizace, zálohy a hlídání dostupnosti i bezpečnosti. Jednáte přímo se mnou.";
/** Časté otázky (data/otazky.ts) – zobrazí se na stránce a zároveň jdou do strukturovaných dat. */
const faq = otazky(["postarate-hosting-provoz", "kolik-stoji-sprava-serveru", "komu-patri-aplikace-web", "jak-probiha-15min-hovor", "co-stane-po-odeslani"]);
const jsonLd = graph(
  serviceLd({ path, name: "Správa serverů a webů", serviceType: "Správa serverů a webů", description, minPrice: 990, monthly: true }),
  crumbsLd([["Domů", "/"], ["Správa serverů a webů", path]]),
  faqLd(faq),
);
---
<Sub
  title="Správa serverů a webů – Karlovy Vary, Plzeň | WebTitan"
  description={description}
  path={path}
  og={{ title: "Správa serverů a webů od 990 Kč/měsíc – WebTitan" }}
  jsonLd={jsonLd}
  offer="web"
  cta="sp"
  lead={{"heading": "Pojďme probrat správu vašeho webu", "topic": "Správa serveru", "placeholder": "Např. máme web na WordPressu a nikdo se nestará o aktualizace ani zálohy."}}
>
  <section class="sp-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Drobečková navigace"><ol><li><a href="/">Domů</a></li><li aria-current="page">Správa serverů a webů</li></ol></nav>
      <div class="hero-grid">
        <div class="card intro">
          <div><span class="kicker">Hosting a provoz</span></div>
          <h1>Správa serverů a&nbsp;webů</h1>
          <p class="lead">Aby všechno běželo a&nbsp;vy jste to nemuseli řešit. Servery spravuji sám – hosting, aktualizace, zálohy i&nbsp;dohled – pro weby, e-shopy i&nbsp;aplikace. Nemusíte hledat dalšího dodavatele ani „toho, kdo to kdysi dělal“.</p>
          <ul class="checks"><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Aktualizace a&nbsp;pravidelné zálohy</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Hlídání dostupnosti a&nbsp;bezpečnosti</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Jednáte přímo se mnou</li></ul>
          <div class="dual"><a href="#poptat" class="btn btn-grad" data-mode="call" data-cta="sp_hero_call"><svg aria-hidden="true"><use href="#i-phone"/></svg>Domluvit 15min hovor</a><a href="#poptat" class="btn btn-line" data-mode="form" data-cta="sp_hero_form">Poslat poptávku</a></div>
          <p class="micro"><span class="mi"><svg aria-hidden="true"><use href="#i-clock"/></svg>Ozvu se do 24 hodin (v&nbsp;pracovní dny)</span><span class="mi"><svg aria-hidden="true"><use href="#i-pin"/></svg>Karlovarský a&nbsp;Plzeňský kraj – i&nbsp;osobně</span><span class="mi"><svg aria-hidden="true"><use href="#i-phone"/></svg>Volejte rovnou: <a href="tel:+420723793510" data-cta="sp_hero_tel">723&nbsp;793&nbsp;510</a></span></p>
        </div>
        <aside class="card sum" aria-label="Shrnutí">
          <div class="sum-price"><small>Cena</small><b class="gt">od 990 Kč</b><span>měsíčně</span></div>
          <dl class="facts">
            <div class="fact"><dt>Termín</dt><dd>průběžně – starám se o&nbsp;provoz</dd></div>
            <div class="fact"><dt>Komu patří kód a&nbsp;data</dt><dd>Vám – kód, data i&nbsp;doména</dd></div>
            <div class="fact"><dt>S&nbsp;kým jednáte</dt><dd>Přímo s&nbsp;tím, kdo to staví</dd></div>
            <div class="fact"><dt>DPH</dt><dd>Nejsem plátce DPH – ceny jsou konečné</dd></div>
          </dl>
          <div class="me-row"><span class="avatar" role="img" aria-label="Jan Šporek"></span><div><b>Jan Šporek</b><span>Weby a&nbsp;aplikace stavím od roku 2006, sídlím u&nbsp;Sokolova. Kdo s&nbsp;vámi mluví, ten to i&nbsp;staví – v&nbsp;Karlovarském a&nbsp;Plzeňském kraji klidně i&nbsp;osobně.</span></div></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="sec" id="pro-koho">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Pro koho to je</span><h2>Pro koho je správa serveru</h2></div><p>Správa dává smysl každému, kdo má web, e-shop nebo aplikaci a&nbsp;nechce řešit, na čem a&nbsp;jak běží.</p></div>
      <div class="pains ok"><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg></span><h3>Máte web, e-shop nebo aplikaci</h3><p>A&nbsp;nechcete řešit hosting, aktualizace ani zálohy.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5v.7M12 17h.01"/></svg></span><h3>Nevíte, kdo web kdysi dělal</h3><p>Nemusíte hledat dalšího dodavatele ani „toho, kdo to kdysi dělal“.</p></article><article class="card pain"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><h3>Chcete jednoho člověka</h3><p>Od návrhu přes vývoj po provoz – kdo s&nbsp;vámi mluví, ten to i&nbsp;staví.</p></article></div>
    </div>
  </section>

  <section class="sec" id="co-dostanete">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Co dostanete</span><h2>Co za vás pohlídám</h2></div><p>Servery spravuji sám – hosting, aktualizace, zálohy i&nbsp;dohled.</p></div>
      <div class="get"><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Hosting</h3><p>Web, e-shop nebo aplikace poběží na serveru, o&nbsp;který se starám.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Aktualizace</h3><p>Systém i&nbsp;software držím aktuální, abyste to nemuseli řešit.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Pravidelné zálohy</h3><p>Data jsou pravidelně zálohovaná.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Hlídání dostupnosti a&nbsp;bezpečnosti</h3><p>Dohled nad tím, aby všechno běželo.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Další rozvoj</h3><p>Když budete potřebovat úpravu nebo novou funkci, víte, komu napsat.</p></div></div><div class="card get-item"><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><div><h3>Kód, data i&nbsp;doména patří vám</h3><p>Nejste na mně závislí.</p></div></div></div>
    </div>
  </section>

  <section class="sec" id="postup">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Jak pracuji</span><h2>Jak správa probíhá</h2></div><p>Víte, co se kdy děje a&nbsp;kolik to bude stát – ještě než se do čehokoli pustíme.</p></div>
      <ol class="steps s3"><li class="card step"><div class="step-top"><span class="num">1</span><span class="time">do 24 h · zdarma</span></div><h3>15min hovor</h3><p>Projdeme, co vás dnes zdržuje. Řeknu vám, jestli a&nbsp;jak to jde – po telefonu nebo videohovorem.</p></li><li class="card step"><div class="step-top"><span class="num">2</span><span class="time">cca 1 týden</span></div><h3>Návrh a&nbsp;pevná cena</h3><p>Sepíšu, co bude správa zahrnovat, a&nbsp;pošlu pevnou cenu. Teprve pak se rozhodnete.</p></li><li class="card step"><div class="step-top"><span class="num">3</span><span class="time">průběžně</span></div><h3>Průběžná péče</h3><p>Aktualizace, pravidelné zálohy a&nbsp;hlídání dostupnosti i&nbsp;bezpečnosti – bez vašeho starání.</p></li></ol>
    </div>
  </section>

  <section class="sec" id="cena">
    <div class="wrap">
      <div class="head"><div><span class="kicker">Cena</span><h2>Kolik stojí správa serveru a&nbsp;webu</h2></div></div>
      <div class="card price-card gb">
        <div class="price-big"><small>Cena</small><b class="gt">od 990 Kč</b><span>měsíčně</span></div>
        <div><ul><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Pevnou cenu dostanete po úvodním hovoru – co si odsouhlasíme, to platí.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Správu můžete mít k&nbsp;webu, e-shopu i&nbsp;aplikaci.</li><li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Nejsem plátce DPH, takže uvedené ceny jsou konečné.</li></ul><p class="price-note">Přesnou cenu podle toho, co budu spravovat, vám řeknu po úvodním hovoru.</p></div>
      </div>
    </div>
  </section>
  <Faq heading="Časté otázky ke správě serverů" items={faq} />
  <OtherServices ids={["app", "mob", "web", "shop"]} />
</Sub>
