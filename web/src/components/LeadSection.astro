---
import Honeypot from "./Honeypot.astro";
import Consent from "./Consent.astro";
import FormFail from "./FormFail.astro";
// Kontaktní sekce podstránek a článků (#poptat): přepínač „Zavolejte mi / Napsat poptávku“, formulář pro lead.js
// a panel „Co bude dál“. Liší se jen nadpisem, tématem poptávky a vzorovým textem zprávy.
import { PHONE, PHONE_SHORT, EMAIL } from "../data/site";

interface Props {
  /** Nadpis sekce (HTML). */
  heading: string;
  /** Téma poptávky pro lead.js (data-topic), např. "Web". */
  topic: string;
  /** Vzorový text do pole zprávy. */
  placeholder: string;
  /** Předpona měření kliknutí (sp, it, post). */
  cta?: string;
  /** Kde působím osobně (panel „Co bude dál“, HTML). */
  misto?: string;
}
const { heading, topic, placeholder, cta = "sp", misto = "Karlovarský a&nbsp;Plzeňský kraj – i&nbsp;osobně" } = Astro.props;
---
<section class="sec" id="poptat">
  <div class="wrap">
    <div class="head"><div><span class="kicker">Nezávazně a&nbsp;zdarma</span><h2 set:html={heading}></h2></div><p>Nechte mi číslo a&nbsp;zavolám vám, nebo napište pár vět. Ozvu se do 24 hodin (v&nbsp;pracovní dny).</p></div>
    <div class="lb">
      <div class="card gb lb-card">
        <div class="lb-tabs" role="tablist" aria-label="Způsob kontaktu">
          <button type="button" role="tab" id="lb-tab-call" aria-controls="lb-form" aria-selected="true" data-mode="call"><svg aria-hidden="true"><use href="#i-phone"/></svg>Zavolejte mi</button>
          <button type="button" role="tab" id="lb-tab-form" aria-controls="lb-form" aria-selected="false" tabindex="-1" data-mode="form"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>Napsat poptávku</button>
        </div>
        <form class="lb-form" id="lb-form" role="tabpanel" aria-labelledby="lb-tab-call" data-topic={topic} data-mode="call" novalidate>
          <p class="lb-sub" data-for="call">Stačí jméno a&nbsp;telefon. Zavolám vám do 24 hodin (v&nbsp;pracovní dny), hovor zabere asi 15 minut.</p>
          <p class="lb-sub" data-for="form" hidden>Stačí pár vět – co dnes řešíte a&nbsp;co by mělo fungovat jinak. Odpovím do 24 hodin (v&nbsp;pracovní dny).</p>
          <Honeypot id="hp-lb" />
          <div class="lb-grid">
            <div class="fld"><label for="lb-name">Jméno *</label><input id="lb-name" name="name" type="text" autocomplete="name" placeholder="Jan Novák" aria-describedby="e-lb-name"><p class="err-msg" id="e-lb-name"></p></div>
            <div class="fld" data-for="form" hidden><label for="lb-email">E-mail *</label><input id="lb-email" name="email" type="email" autocomplete="email" placeholder="jan@firma.cz" aria-describedby="e-lb-email"><p class="err-msg" id="e-lb-email"></p></div>
            <div class="fld"><label for="lb-phone">Telefon <em data-for="call">*</em><em data-for="form" hidden>(nepovinné)</em></label><input id="lb-phone" name="phone" type="tel" autocomplete="tel" placeholder="+420 …" aria-describedby="e-lb-phone"><p class="err-msg" id="e-lb-phone"></p></div>
            <div class="fld full" data-for="call"><p class="lb-label" id="lb-when-l">Kdy se vám hodí?</p><div class="chips" role="radiogroup" aria-labelledby="lb-when-l"><label><input type="radio" name="when" value="Kdykoli" checked><span>Kdykoli</span></label><label><input type="radio" name="when" value="Dopoledne"><span>Dopoledne</span></label><label><input type="radio" name="when" value="Odpoledne"><span>Odpoledne</span></label></div></div>
            <div class="fld full"><label for="lb-msg"><span data-for="call">O&nbsp;čem si promluvíme? <em>(nepovinné)</em></span><span data-for="form" hidden>Co potřebujete? *</span></label><textarea id="lb-msg" name="message" rows="3" placeholder={placeholder} aria-describedby="e-lb-msg"></textarea><p class="err-msg" id="e-lb-msg"></p></div>
          </div>
          <div class="lb-foot"><button type="submit" class="btn btn-grad" data-cta={`${cta}_lead_submit`}><span class="lbl">Zavolejte mi</span> <span class="arr">→</span></button><small>Zdarma a&nbsp;nezávazně, nic neprodávám na sílu.</small></div>
          <Consent />
          <FormFail cls="lb-fail" title="Odeslání se nepovedlo – poptávka se ale neztratí." text="Klikněte na tlačítko a&nbsp;pošlete ji e-mailem, všechno je předvyplněné." mailtoClass="lb-mailto" directly />
        </form>
        <div class="lb-done" hidden>
          <span class="lb-ok"><svg aria-hidden="true"><use href="#i-check"/></svg></span>
          <h3 data-done="title" tabindex="-1">Díky! Poptávka dorazila.</h3>
          <p data-done="text"></p>
          <a href="/#reference" class="btn btn-line">Mezitím se podívejte na reference</a>
        </div>
      </div>
      <aside class="card lb-info" aria-label="Co bude dál">
        <div class="me-row"><span class="avatar" role="img" aria-label="Jan Šporek"></span><div><b>Jan Šporek</b><span>Odpovídám osobně. Kdo s&nbsp;vámi mluví, ten to i&nbsp;staví.</span></div></div>
        <ol class="lb-steps">
          <li><span class="n">1</span><div><b>Ozvu se do 24 hodin</b><span>Zavolám, nebo odpovím e-mailem.</span></div></li>
          <li><span class="n">2</span><div><b>Krátký hovor zdarma</b><span>Probereme, co potřebujete a&nbsp;jak to vyřešit.</span></div></li>
          <li><span class="n">3</span><div><b>Návrh s&nbsp;pevnou cenou</b><span>Rozsah, termín a&nbsp;cenu dostanete písemně. Rozhodnete se v&nbsp;klidu.</span></div></li>
        </ol>
        <ul class="lb-sure">
          <li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Nic nepodepisujete, vše je nezávazné</li>
          <li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span>Kód, data i&nbsp;doména patří vám</li>
          <li><span class="tick" aria-hidden="true"><svg><use href="#i-check"/></svg></span><Fragment set:html={misto} /></li>
        </ul>
        <p class="lb-alt">Radši rovnou zavolat? <a href={`tel:${PHONE}`} data-cta={`${cta}_lead_tel`} set:html={PHONE_SHORT}></a><br>Nebo pište na <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </aside>
    </div>
  </div>
</section>
