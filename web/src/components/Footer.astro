---
// Patička: odkazy, služby (z data/sluzby.ts), kontakt a právní údaje.
// home = úvodní stránka (kotvy na sekce), sub = podstránky a články (nadpis „Služby“, zvýrazněná aktuální služba),
// simple = ochrana údajů a 404. current = adresa aktuální stránky (aria-current), cta = předpona měření.
// Rok se vypíše při buildu a v prohlížeči se doplní aktuální (web se mezi lety nemusí znovu sestavit).
import { PHONE, PHONE_LONG, EMAIL, LINKEDIN, GITHUB, LEGAL } from "../data/site";
import { SLUZBY } from "../data/sluzby";

interface Props { variant: "home" | "sub" | "simple"; current?: string; cta?: string }
const { variant, current, cta = "sp" } = Astro.props;

const home = variant === "home";
const pre = home ? "" : "/";
const links = [
  { href: `${pre}#sluzby`, label: "Služby a&nbsp;ceny" },
  { href: `${pre}#reference`, label: "Reference" },
  { href: `${pre}#kalkulacka`, label: "Kalkulačka" },
  ...(home ? [{ href: "#kontrola", label: "Posouzení zdarma" }] : []),
  { href: `${pre}#faq`, label: "Otázky" },
  { href: "/clanky/", label: "Články" },
  { href: "/ochrana-osobnich-udaju.html", label: "Ochrana osobních údajů" },
];
const telCta = home ? "foot_tel" : variant === "sub" ? `${cta}_foot_tel` : undefined;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap foot">
    <a href={home ? "#" : "/"} class="brand"><img src="/assets/logo-52.png" alt="" width="26" height="26" loading="lazy" decoding="async">WebTitan <small>· Jan Šporek</small></a>
    <nav aria-label="Patička">
      {links.map((l) => <a href={l.href} aria-current={l.href === current ? "page" : undefined} set:html={l.label}></a>)}
    </nav>
    <nav class="foot-svc" aria-label="Služby">{variant === "sub" && <b>Služby</b>}{SLUZBY.map((s) => <a href={s.url} aria-current={variant === "sub" && s.url === current ? "page" : undefined} set:html={s.nazev}></a>)}</nav>
    <div class="foot-bottom">
      <span>© <span id="year">{year}</span> Jan Šporek · WebTitan</span>
      <script is:inline>document.getElementById("year").textContent = new Date().getFullYear();</script>
      <span class="foot-contact">
        <a href={`tel:${PHONE}`} data-cta={telCta} set:html={PHONE_LONG}></a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      </span>
    </div>
    <p class="foot-legal" set:html={LEGAL}></p>
  </div>
</footer>
