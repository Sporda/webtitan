---
// Časté otázky na podstránkách služeb (#otazky). Stejné položky jdou i do strukturovaných dat (lib/ld.ts faqLd).
import FaqItems from "./FaqItems.astro";
interface Props { heading: string; items: { q: string; a: string }[] }
const { heading, items } = Astro.props;
---
<section class="sec" id="otazky">
  <div class="wrap">
    <div class="head"><div><span class="kicker">Časté otázky</span><h2 set:html={heading}></h2></div><p>Nenašli jste odpověď? Zeptejte se mě rovnou – na hovoru nebo e-mailem.</p></div>
    <div class="faq-list"><FaqItems items={items} /></div>
  </div>
</section>
