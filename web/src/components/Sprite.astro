---
// Sada ikon <symbol> pro <use href="#i-…">. Úvodní stránka používá víc ikon než podstránky.
// Ikony služeb se berou z data/sluzby.ts (ikona), aby byly jen na jednom místě.
import { SLUZBY, type SluzbaId } from "../data/sluzby";
interface Props { variant: "home" | "sub" }
const { variant } = Astro.props;

const SLUZBA_SYMBOL: Record<SluzbaId, string> = { app: "i-app", mob: "i-mobile", web: "i-web", shop: "i-shop", srv: "i-srv", it: "i-net" };
const SYMBOLS: Record<string, string> = {
  ...Object.fromEntries(SLUZBY.map((s) => [SLUZBA_SYMBOL[s.id], s.ikona])),
  "i-q": '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5v.7M12 17h.01"/>',
  "i-check": '<path d="M20 6 9 17l-5-5"/>',
  "i-x": '<path d="M18 6 6 18M6 6l12 12"/>',
  "i-arrow": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "i-phone": '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  "i-pin": '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  "i-cal": '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  "i-send": '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/>',
  "i-clock": '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  "i-chat": '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  "i-user": '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  // LinkedIn je plná ikona (fill), ne obrys – vykreslí se podle CSS svého <svg> (.icon-btn)
  "i-in": '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>',
};

const SETS = {
  home: ["i-web", "i-shop", "i-app", "i-mobile", "i-srv", "i-net", "i-q", "i-check", "i-x", "i-arrow", "i-phone", "i-cal", "i-send", "i-clock", "i-pin", "i-chat", "i-user", "i-in"],
  sub: ["i-check", "i-x", "i-phone", "i-pin", "i-clock"],
};
const markup = SETS[variant].map((id) => `<symbol id="${id}" viewBox="0 0 24 24">${SYMBOLS[id]}</symbol>`).join("");
---
<svg class="sprite" aria-hidden="true" focusable="false" set:html={markup}></svg>
